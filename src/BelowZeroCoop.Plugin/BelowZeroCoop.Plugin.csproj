<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildProjectDirectory)/../../external/BepInEx/core</BepInExCore>
    <GameManaged Condition="'$(GameManaged)' == ''">$(MSBuildProjectDirectory)/../../external/Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="../BelowZeroCoop.Protocol/BelowZeroCoop.Protocol.csproj" />
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)/BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
